# Backend
DATABASE_URL=sqlite:///./data/semyainfo.sqlite
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI (локальный opencode serve: opencode serve --port 4096)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=opencode/deepseek-v4-flash-free

# DB seed
SEED_ADMIN_EMAIL=admin@semyainfo.dev
SEED_ADMIN_PASSWORD=admin123
SEED_EDITOR_EMAIL=editor@semyainfo.dev
SEED_EDITOR_PASSWORD=editor123

# AI defaults
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_KNOWLEDGE_TOP_K=5